# Copy to .env at the monorepo root. Placeholder values only — never commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
JWT_SECRET=super-long-random-access-secret-change-me
JWT_REFRESH_SECRET=another-long-random-refresh-secret-change-me
# Optional: OpenAI powers embeddings (semantic search) and the chat agent.
# OPENAI_API_KEY=
# OpenSearch node the SearchService connects to.
OPENSEARCH_NODE=http://localhost:9200
# Redis for BullMQ background jobs and transactional outbox delivery.
REDIS_URL=redis://localhost:6379
# Stripe test-mode keys only; the app rejects live secret keys.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend URL used for Stripe success/cancel redirects.
FRONTEND_URL=http://localhost:8080
# Local email delivery uses Mailpit in Docker Compose (web UI: localhost:8025).
# For source mode, SMTP_HOST=localhost. Never use these local settings in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="ShopPilot Demo <no-reply@shoppilot.local>"
# Optional Sentry project DSNs; empty values disable Sentry.
# Frontend DSN is public and compiled into frontend assets; never put a secret here.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=local
# Backend DSN; configure as a server secret outside local development.
# SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Reserved for future provider adapters; currently unused by the application.
# SHIPPING_PROVIDER=disabled
# SHIPPO_API_TOKEN=
# TAX_PROVIDER=disabled
# TAXJAR_API_KEY=
# PRODUCT_ENRICHMENT_PROVIDER=disabled
# PRODUCT_ENRICHMENT_API_KEY=
# CURRENCY_CONVERSION_PROVIDER=disabled
# CURRENCY_CONVERSION_API_KEY=
# Required only to ingest shared FAQ/policy documents.
# KNOWLEDGE_INGESTION_TOKEN=
# Required to expose the authenticated, read-only MCP endpoint.
# MCP_API_TOKEN=
# Optional JSON map of provider name to webhook HMAC secret.
# WEBHOOK_SECRETS={"example":"replace-with-a-random-secret-at-least-16-chars"}
# Optional model selection/fallback and cost rates (USD per million tokens).
# With a daily budget enabled, costs are estimated and atomically reserved in PostgreSQL.
AI_PROVIDER=openai
# AI_API_KEY=
# AI_API_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_FALLBACK_CHAT_MODEL=
# AI_COST_INPUT_USD_PER_MILLION=
# AI_COST_OUTPUT_USD_PER_MILLION=
# AI_DAILY_BUDGET_USD=
# AI_REQUEST_TIMEOUT_MS=20000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9464

PORT=3500
