generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
}

enum EventType {
  VIEW
  SEARCH
  CART_ADD
  CART_REMOVE
  PURCHASE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  password     String
  role         Role     @default(BUYER)
  refreshToken String?
  createdAt    DateTime @default(now())

  orders             Order[]
  products           Product[]
  events             UserEvent[]
  tickets            SupportTicket[]
  knowledgeDocuments KnowledgeDocument[] @relation("KnowledgeOwner")
  aiActions          AIAction[]
  aiUsages           AIUsage[]
  toolAudits         AgentToolAudit[]

  @@map("users")
}

model Product {
  id            String    @id @default(uuid())
  name          String
  description   String
  price         Decimal   @db.Decimal(10, 2)
  category      String
  image         String
  rating        Decimal   @db.Decimal(2, 1)
  inStock       Boolean   @default(true)
  features      String[]
  salePrice     Decimal?  @db.Decimal(10, 2)
  dealExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sellerId String?
  seller   User?   @relation(fields: [sellerId], references: [id])

  orderItems OrderItem[]
  events     UserEvent[]

  @@map("products")
}

model Order {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id])
  total                   Decimal  @db.Decimal(10, 2)
  status                  String   @default("pending")
  idempotencyKey          String?
  requestHash             String?
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId   String?
  checkoutAttempt         Int      @default(0)
  createdAt               DateTime @default(now())

  items OrderItem[]

  @@unique([userId, idempotencyKey])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model UserEvent {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          EventType
  outboxEventId String?   @unique
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  query         String?
  quantity      Int?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("user_events")
}

model OutboxEvent {
  id        String    @id @default(uuid())
  type      String
  payload   Json
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("outbox_events")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  subject   String
  message   String
  orderId   String?
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("support_tickets")
}

model KnowledgeDocument {
  id          String           @id @default(uuid())
  title       String
  sourceUrl   String
  category    String
  content     String           @db.Text
  ownerUserId String?
  owner       User?            @relation("KnowledgeOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  chunks      KnowledgeChunk[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([ownerUserId, category])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal    Int
  content    String            @db.Text
  embedding  Json?
  createdAt  DateTime          @default(now())

  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("knowledge_chunks")
}

model AIAction {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  status    String           @default("PENDING")
  payload   Json
  result    Json?
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  audits    AgentToolAudit[]

  @@index([userId, status, expiresAt])
  @@map("ai_actions")
}

model AgentToolAudit {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  actionId  String?
  action    AIAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  toolName  String
  status    String
  details   Json?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([actionId, createdAt])
  @@map("agent_tool_audits")
}

model AIUsage {
  id                   String    @id @default(uuid())
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider             String
  model                String
  inputTokens          Int
  outputTokens         Int
  estimatedCost        Decimal   @db.Decimal(12, 8)
  latencyMs            Int
  status               String
  tokenEstimate        Boolean   @default(false)
  costConfigured       Boolean   @default(false)
  reservationExpiresAt DateTime?
  createdAt            DateTime  @default(now())

  @@index([createdAt, provider, model])
  @@map("ai_usage")
}

model WebhookReceipt {
  id               String   @id @default(uuid())
  provider         String
  eventId          String
  eventType        String
  payload          Json
  status           String   @default("RECEIVED")
  deliveryAttempts Int      @default(1)
  lastError        String?
  receivedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([provider, status, receivedAt])
  @@map("webhook_receipts")
}
